# ─────────────────────────────────────────────────────────────
# Rizq AI Payments — environment variables (placeholders only)
# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file. It is git-ignored.
# Only VITE_-prefixed values are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Supabase (project > Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Gemini (Google AI Studio > API keys)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional. Defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# PayPal Sandbox (developer.paypal.com > My Apps & Credentials)
# Use the Sandbox tab, not Live, for testing.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
